# ReadFirst Website Environment Variables

# EmailJS Provider Settings
# 1. Sign up / Log in to EmailJS: https://dashboard.emailjs.com/
# 2. Add an Email Service (e.g. Gmail / Outlook / SMTP) -> Get your Service ID
# 3. Create an Email Template -> Get your Template ID (Use our provided HTML template in /email-templates)
# 4. In EmailJS Account Settings -> API Keys -> Copy your Public Key

VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Optional: Default Admissions / Notification Recipient (used if your template references it)
VITE_EMAILJS_TO_EMAIL=admissions@readfirst.in

# Optional REST webhook/enquiry endpoint fallback
VITE_CONTACT_ENDPOINT=
